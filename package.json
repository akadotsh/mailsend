{
  "name": "duta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "dev": "tsx watch src/core/index.ts",
    "start": "tsx src/core/index.ts",
    "build": "tsc",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives src",
    "lint:fix": "oxlint --type-aware --deny-warnings --report-unused-disable-directives --fix src",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}

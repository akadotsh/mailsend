{
  "name": "mailsend-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive build",
    "cli": "pnpm --filter @akadotsh/mailsend cli",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --filter @akadotsh/mailsend-sdk build:types && pnpm --recursive typecheck",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives packages",
    "lint:fix": "oxlint --type-aware --deny-warnings --report-unused-disable-directives --fix packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "keytar"
    ]
  }
}
